# Required for the real LLM agent in Demo and Live Mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Live Mode local API tools. Use a read-only Binance API key.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Documented for users who connect Agent OS through a compatible AI client.
# The official MCP endpoint uses browser authorization, not this app's API keys.
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic

# Optional. The official MCP requires an OAuth token obtained through a supported
# client authorization flow. Never substitute a Binance API key here.
BINANCE_AGENT_OS_MCP_ACCESS_TOKEN=
